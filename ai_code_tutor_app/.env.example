# Copy this to .env for local Docker runs. Never commit real secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
ALLOW_CODE_RUNNER=false
APP_DATA_DIR=data
APP_TIMEZONE=America/Los_Angeles

# Private hosted use: set both values before sharing a deployed link.
# Local-only use can leave these blank.
APP_PRIVATE_MODE=false
APP_PRIVATE_PASSCODE=

# Leave unset unless you intentionally want to skip the SQLite backup snapshot.
APP_DISABLE_SQLITE_BACKUP=false
